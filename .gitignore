.env
.env.local
.env.*.local

# Local credentials
/secrets/
**/application_default_credentials.json
**/*service-account*.json

# Generated Firebase state
/.firebase/

# JavaScript dependencies and builds
**/node_modules/
**/dist/
**/.expo/
**/.cache/

