# Local environment values
.env
.env.local
.env.*.local

# Local credentials
/secrets/
**/application_default_credentials.json
**/*service-account*.json
*.key
*.pem

# Firebase local state
/.firebase/
**/firebase-debug.log
**/firestore-debug.log
**/ui-debug.log

# JavaScript dependencies and builds
**/node_modules/
**/dist/
**/.cache/

# Expo
**/.expo/
**/web-build/

# Python
**/__pycache__/
**/*.py[cod]
**/.venv/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/

# Native build artifacts (EAS/Gradle/Xcode output)
*.apk
*.aab
*.ipa

# Test output
**/coverage/

# Logs
*.log

# Personal git hook overrides
lefthook-local.yml

# Operating systems
.DS_Store
Thumbs.db

# Editors
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/

# Native projects generated by `expo prebuild` / `expo run` (regenerated from app.json, never committed)
/apps/app/android/
/apps/app/ios/

# Gradle and CMake output inside local Expo modules
/apps/app/modules/*/android/build/
/apps/app/modules/*/android/.cxx/
