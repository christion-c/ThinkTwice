#---------------------------------------------------------
#Docker Compose
#---------------------------------------------------------
COMPOSE_PROJECT_NAME=thinktwice

#---------------------------------------------------------
#PostgreSQL
#---------------------------------------------------------
POSTGRES_DB=thinktwice
POSTGRES_USER=thinktwice
POSTGRES_PASSWORD=thinktwice_dev
POSTGRES_PORT=5433

#---------------------------------------------------------
#Back end
#---------------------------------------------------------
BACKEND_PORT=3000
CORS_ORIGIN=*

#Google Cloud project used by Firebase Admin.
GOOGLE_CLOUD_PROJECT=thinktwice-dev-christion

#Replace this value with the absolute path to local Google ADC created with
#service-account impersonation. Never place a service-account private key here.
GOOGLE_ADC_PATH=REPLACE_WITH_ABSOLUTE_PATH_TO_ADC

#--------------------------------------------------------
#Front end
#---------------------------------------------------------
EXPO_PORT=8081

#Web browser:
EXPO_PUBLIC_API_URL=http://localhost:3000/

#Physical phone example:
#EXPO_PUBLIC_API_URL=http://192.168.1.100:3000/

#Android emulator example:
#EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/

#Firebase web-app configuration. These EXPO_PUBLIC values are embedded in the
#client and must never contain private keys or other secrets.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

#Optional Google OAuth client IDs. Native OAuth requires an Expo development
#build; it cannot be tested in Expo Go.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

#---------------------------------------------------------
#Machine learning
#---------------------------------------------------------
ML_PORT=8000

#---------------------------------------------------------
#Development tools
#---------------------------------------------------------
ADMINER_PORT=8080