# ---------------------------------------------------------
# Docker Compose
# ---------------------------------------------------------
COMPOSE_PROJECT_NAME=thinktwice

# ---------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------
POSTGRES_DB=thinktwice
POSTGRES_USER=thinktwice
POSTGRES_PASSWORD=thinktwice_dev
POSTGRES_PORT=5433

# ---------------------------------------------------------
# Back end
# ---------------------------------------------------------
BACKEND_PORT=3000
CORS_ORIGIN=*

# Shared secret the ML service presents to the backend's internal,
# service-to-service routes (e.g. GET /fill-up-history/internal). Not a
# Firebase user token. Falls back to a dev-only default if unset locally;
# set a real random value in production.
INTERNAL_SERVICE_TOKEN=dev-only-internal-token-change-me

# Google Cloud project used by Firebase Admin.
GOOGLE_CLOUD_PROJECT=thinktwice-dev-christion

# Replace this value with the absolute path to local Google ADC created with
# service-account impersonation. Never place a service-account private key here.
GOOGLE_ADC_PATH=REPLACE_WITH_ABSOLUTE_PATH_TO_ADC

# ---------------------------------------------------------
# Front end
# ---------------------------------------------------------
EXPO_PORT=8081

# Web browser:
EXPO_PUBLIC_API_URL=http://localhost:3000

# Physical phone example:
# EXPO_PUBLIC_API_URL=http://192.168.1.100:3000

# Android emulator example:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:3000

# Firebase web-app configuration. These EXPO_PUBLIC values are embedded in the
# client and must never contain private keys or other secrets.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google sign-in. Web uses Firebase's popup and needs neither value. Android
# and iOS need the *Web* OAuth client ID (Firebase Auth > Google provider >
# Web SDK configuration) and only work in a development or release build,
# not Expo Go; Android also needs each signing key's SHA-1 in Firebase.
# The iOS client ID is needed only for iOS builds.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# ---------------------------------------------------------
# Machine learning
# ---------------------------------------------------------
ML_PORT=8000

# ---------------------------------------------------------
# Development tools
# ---------------------------------------------------------
ADMINER_PORT=8080
