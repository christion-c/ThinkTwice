# Copy to .env (never committed). Used by compose.yaml to create the local database.
# Generate each password with: openssl rand -hex 24
# The owner and app passwords must match the ones in services/api/.env.

# PostgreSQL superuser. Only used to create the roles and databases below.
POSTGRES_SUPERUSER_PASSWORD=change-me

# Owns the tables and runs migrations.
THINKTWICE_OWNER_PASSWORD=change-me

# Used by the API. Can only read and write rows, always subject to row-level security.
THINKTWICE_APP_PASSWORD=change-me
