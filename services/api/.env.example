# Copy to .env for local development (never committed).
# The passwords below must match THINKTWICE_OWNER_PASSWORD and THINKTWICE_APP_PASSWORD in the root .env.

# Where the API listens.
HOST=127.0.0.1
PORT=3000

# fatal, error, warn, info, debug, trace or silent.
LOG_LEVEL=info

# Comma-separated browser origins allowed to call the API (Expo web dev server).
CORS_ORIGINS=http://localhost:8081

# Set to true only when running behind a trusted reverse proxy or load balancer.
TRUST_PROXY=false

# Requests allowed per client per minute.
RATE_LIMIT_MAX=100

# The API connects as thinktwice_app, which is always subject to row-level security.
DATABASE_URL=postgresql://thinktwice_app:change-me@127.0.0.1:5432/thinktwice

# Migrations run as thinktwice_owner, which owns the tables (pnpm --filter @thinktwice/api db:migrate).
MIGRATION_DATABASE_URL=postgresql://thinktwice_owner:change-me@127.0.0.1:5432/thinktwice

# Tests use a separate database so they never touch development data.
TEST_DATABASE_URL=postgresql://thinktwice_app:change-me@127.0.0.1:5432/thinktwice_test
TEST_MIGRATION_DATABASE_URL=postgresql://thinktwice_owner:change-me@127.0.0.1:5432/thinktwice_test
