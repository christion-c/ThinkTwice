{
  "name": "@thinktwice/api",
  "version": "0.0.0",
  "private": true,
  "description": "ThinkTwice REST API.",
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "11.3.1",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.1",
    "@thinktwice/shared": "workspace:*",
    "fastify": "5.12.7",
    "fastify-type-provider-zod": "7.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "pino-pretty": "13.2.0",
    "vitest": "5.0.5"
  }
}
