# Copy to .env for local development (never committed).

# Shared secret the API must send with every request (Authorization: Bearer <token>).
# Generate with: openssl rand -hex 32. The API's ML_SERVICE_TOKEN must match it.
ML_SERVICE_TOKEN=change-me-to-a-random-64-character-hex-string

# CRITICAL, ERROR, WARNING, INFO or DEBUG.
LOG_LEVEL=INFO
