# Copy to .env (never committed). Expo builds these EXPO_PUBLIC_ values into the app, so they must never be secrets.

# Firebase web app config: Firebase console > Project settings > Your apps > Web app (project thinktwice-dev-christion).
# These identify the project; Firebase security doesn't rely on keeping them private.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=thinktwice-dev-christion.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=thinktwice-dev-christion
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google sign-in on Android: Firebase console > Authentication > Sign-in method > Google >
# Web SDK configuration > Web client ID. Not needed on the web, where Firebase shows Google's pop-up.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# The ThinkTwice API. On the Android emulator, "localhost" is rewritten to the computer running it (10.0.2.2).
EXPO_PUBLIC_API_URL=http://localhost:3000
