{
  "expo": {
    "name": "ThinkTwice",
    "slug": "thinktwice",
    "scheme": "thinktwice",
    "version": "2.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.thinktwice.app"
    },
    "android": {
      "package": "com.thinktwicefinance.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FBF2E4"
      }
    },
    "web": {
      "output": "static",
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": ["expo-router", "expo-status-bar"],
    "extra": {
      "eas": {
        "projectId": "fe8d07cb-32c4-4722-98e8-3d6637f59df4"
      }
    },
    "owner": "ccallahan",
    "icon": "./assets/images/icon.png"
  }
}
