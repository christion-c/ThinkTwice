{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "types": [
      "jest",
      "expo/types"
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "@thinktwice/shared-types": [
        "../../packages/shared-types/index.d.ts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
  ]
}
