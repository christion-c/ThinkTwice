{
  "name": "@thinktwice/backend",
  "version": "0.1.0",
  "description": "ThinkTwice back-end API",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "bash -c \"shopt -s globstar; export DATABASE_URL=\\${DATABASE_URL:-postgresql://thinktwice:thinktwice_dev@localhost:5433/thinktwice}; export INTERNAL_SERVICE_TOKEN=\\${INTERNAL_SERVICE_TOKEN:-test-only-internal-token}; tsx --test --experimental-test-module-mocks src/**/*.test.ts\""
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "firebase-admin": "^14.2.0",
    "helmet": "^8.1.0",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.20.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
