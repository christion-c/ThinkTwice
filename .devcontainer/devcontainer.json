{
  "name": "ThinkTwice Full-Stack Development",

  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",

  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
  "workspaceFolder": "/workspace",

  // Publishes Expo's dev server (Metro) straight to the host, bound to
  // localhost only. VS Code's own port forwarding relays every byte
  // through its remote connection, which made the ~12 MB development
  // bundle load very slowly on a phone connected over USB
  // (adb reverse tcp:8081 tcp:8081). Localhost-only so Metro, which
  // serves the app's source, isn't exposed to the rest of the network.
  "runArgs": ["--publish", "127.0.0.1:8081:8081"],

  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12"
    },
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },

  "mounts": [
    "source=thinktwice-backend-node-modules,target=/workspace/apps/backend/node_modules,type=volume",
    "source=thinktwice-frontend-node-modules,target=/workspace/apps/frontend/node_modules,type=volume",
    "source=thinktwice-ml-venv,target=/workspace/services/ml/.venv,type=volume"
  ],

  "postCreateCommand": "bash .devcontainer/setup.sh",

  "forwardPorts": [
    3000,
    5433,
    8000
  ],

  "portsAttributes": {
    "3000": {
      "label": "Backend API",
      "onAutoForward": "silent"
    },
    "5433": {
      "label": "PostgreSQL",
      "onAutoForward": "silent"
    },
    "8000": {
      "label": "ML Service",
      "onAutoForward": "silent"
    },
    "8081": {
      "label": "Expo (published directly via runArgs)",
      "onAutoForward": "ignore"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-azuretools.vscode-docker"
      ],
      "settings": {
        "typescript.tsdk": "apps/backend/node_modules/typescript/lib",
        "python.defaultInterpreterPath": "/workspace/services/ml/.venv/bin/python",
        "editor.formatOnSave": true
      }
    }
  },

  "remoteUser": "node"
}
